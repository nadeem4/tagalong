{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "bodies/*/src/test-setup.ts",
    "bodies/*/src/**/*.test.ts",
    "bodies/*/src/**/*.test.tsx",
    "bodies/*/src/**/*.test-d.ts",
    "protocol/ts/src/**/*.test.ts",
    "bodies/desktop/src/renderer/src/env.d.ts",
    "bodies/*/playwright.config.ts",
    "bodies/*/e2e/**/*.ts"
  ]
}
