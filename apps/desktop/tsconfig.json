{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // electron-vite owns dist/ (package.json `main` is dist/main.js), so tsc is a
    // typecheck that emits only declarations, and it emits them somewhere else.
    "outDir": "./out",
    "rootDir": "./src",
    "emitDeclarationOnly": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    // React is a @tagalong/ui dependency and this app may not add dependencies of its
    // own; the renderer borrows the declarations the ui package already resolves. The
    // vite config points the runtime at that same copy, so there is one React.
    "paths": {
      "react": ["../../packages/ui/node_modules/@types/react"],
      "react/*": ["../../packages/ui/node_modules/@types/react/*"],
      "react-dom": ["../../packages/ui/node_modules/@types/react-dom"],
      "react-dom/*": ["../../packages/ui/node_modules/@types/react-dom/*"]
    }
  },
  // Bean's manifest is imported by the avatar window; JSON is only included when listed.
  "include": ["src/**/*", "src/renderer/src/bean/manifest.json"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    { "path": "../../packages/protocol" },
    { "path": "../../packages/core" },
    { "path": "../../packages/ui" }
  ]
}
