{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // electron-vite owns dist/ (package.json `main` is dist/main.js), so tsc is a
    // typecheck that emits only declarations, and it emits them somewhere else.
    "outDir": "./out",
    "rootDir": "./src",
    "emitDeclarationOnly": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [{ "path": "../../protocol/ts" }, { "path": "../ui" }]
}
