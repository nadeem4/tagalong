{
  "appId": "dev.tagalong.desktop",
  "productName": "Tagalong",
  "copyright": "Copyright \u00a9 2026 Tagalong",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "package.json"],
  "asar": true,
  "asarUnpack": ["**/*.node"],
  "npmRebuild": false,
  "publish": null,
  "extraResources": [
    {
      "from": "../browser/dist",
      "to": "extension"
    },
    {
      "from": "build/uv",
      "to": "uv"
    },
    {
      "from": "../../brain",
      "to": "brain",
      "filter": ["pyproject.toml", "uv.lock", "src/**/*", "!**/__pycache__/**", "!**/*.pyc"]
    }
  ],
  "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "executableName": "Tagalong"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Tagalong",
    "runAfterFinish": true,
    "include": "build/installer.nsh",
    "deleteAppDataOnUninstall": false
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.productivity"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility",
    "maintainer": "Tagalong",
    "executableName": "tagalong"
  }
}
