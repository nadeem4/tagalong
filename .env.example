# Reference list of the environment variables Tagalong reads. Nothing loads this file; the
# desktop reads only the real environment. The brain reads the real
# environment first, then fills any gaps from a .env file in its data folder
# (TAGALONG_HOME, default ~/.tagalong/.env). Each entry says which side reads it.
# Leave a value empty to use its default.

# --- brain (cd brain && uv run brain) ---

# Anthropic API key for Scout's thinking. The app sets it (the brain saves it in its .env); this
# variable is the developer path and wins over the saved key. Without any key the brain still starts
# and Scout stays silent. Experts do not use it (they run on your Claude Code login).
ANTHROPIC_API_KEY=

# Where the brain keeps its data (memory, chat, session id). Default: ~/.tagalong
TAGALONG_HOME=

# Host:port the websocket server listens on. Default: 127.0.0.1:47321
# The desktop reads the same name to know where to dial (see below).
TAGALONG_BRAIN_ADDR=

# Model Scout thinks with when none is chosen in Settings. Default: claude-opus-5-5
# (a choice made in Settings > Scout's model wins over this)
TAGALONG_MODEL=

# Speech models for voice: a model id from brain/src/brain/voice/stt_models.json, or auto.
# Live is the model that shows words while you talk (default auto: moonshine-tiny).
TAGALONG_STT_LIVE=
# Final re-transcribes the whole turn when you finish (at most the last 60 s, only if you spoke):
# a model id (whisper-small-en, whisper-large-v3-turbo), auto, same (use the live words) or off.
# Auto has no final model yet. If it cannot be loaded, the live words are used.
TAGALONG_STT_FINAL=

# Daily spend cap in US dollars. Default: 5.0
TAGALONG_DAILY_BUDGET_USD=

# Model that reads mail for loops. Default: claude-haiku-5-5
TAGALONG_READER_MODEL=

# Daily spend cap for the mail reader in US dollars, apart from Scout's. Default: 0.5
TAGALONG_READER_DAILY_USD=

# Seconds between reads of a mail app that is switched on for loops. Default: 300
TAGALONG_LOOP_POLL_S=

# Days a held loop may sit untouched before Scout is asked to keep or drop it. Default: 7
TAGALONG_LOOP_STALE_DAYS=

# Command of one custom expert (an ACP agent), listed as "custom" beside the installed experts.
# Default: none. Installed experts need no setting here. If you installed the Claude Code adapter
# globally with npm before, set claude-agent-acp here, or let Scout install it.
TAGALONG_EXPERT_CMD=

# Minutes a running job may show no new step or message before Scout is woken to decide
# (a positive number). A job has no run limit. Default: 20
TAGALONG_JOB_QUIET_MIN=

# Seconds an expert's adapter stays running after its last job ends, so a follow-up reuses it.
# 0 stops it at once. Default: 300
TAGALONG_EXPERT_IDLE_S=

# Seconds one thinking turn may take. Default: 300
TAGALONG_TURN_TIMEOUT_S=

# Milliseconds the brain's event loop may be blocked before the brain logs a warning
# (a positive whole number). Default: 200
TAGALONG_LOOP_LAG_MS=

# Most steps Scout takes in one turn. Default: 25
TAGALONG_STEP_CAP=

# Most times Scout may wake and speak first in an hour. Default: 12
TAGALONG_WAKES_PER_HOUR=

# Local hours when Scout holds what it would say (HH:MM-HH:MM, may wrap midnight, e.g. 22:00-07:00); held news shows on Home. Default: none
TAGALONG_QUIET_HOURS=

# Approvals of the same kind before Scout offers a preference. Default: 3
TAGALONG_OFFER_MIN_APPROVALS=

# Days those approvals are counted over. Default: 14
TAGALONG_OFFER_WINDOW_DAYS=

# Days Scout keeps asking after a "not now" on an offer. Default: 7
TAGALONG_KEEP_ASKING_DAYS=

# Characters of one tool result (brain tool, connected app, expert report) Scout sees at
# once; the rest is kept and read by id with read_output. Default: 4000
TAGALONG_TOOL_PREVIEW_CHARS=

# Days finished work (jobs, timers, asks, loops, with their steps and long reports) is kept
# after it ended, then swept at start. Open work is never swept. Default: 30
TAGALONG_WORK_KEEP_DAYS=

# Stored long tool results kept for read_output, newest first. Those a job's report still
# points at are kept as well. Default: 200
TAGALONG_OUTPUTS_KEEP=

# Steps one job's log keeps; the oldest go first, leaving one "older steps dropped" line.
# Default: 2000
TAGALONG_JOB_STEPS_MAX_ENTRIES=

# Text bytes one job's log keeps (command output is blanked first). Default: 1000000
TAGALONG_JOB_STEPS_MAX_BYTES=

# The build id the brain reports in hello. The desktop sets it to the app version when packaged;
# leave empty in a dev checkout (a hash of the source is used).
TAGALONG_BUILD=

# Set to "desktop" by Tagalong when it starts the brain, so it may restart it. Leave empty when you
# start the brain yourself: the desktop then never stops it.
TAGALONG_STARTED_BY=

# How many times a step is retried when it failed for a passing reason (timeout, network,
# rate limit) and is safe to repeat. Default: 3
TAGALONG_RETRY_MAX=

# Seconds to wait before each retry, comma-separated; the last value repeats. Default: 30,120,600
TAGALONG_RETRY_BACKOFF_S=

# --- WhatsApp bridge (the brain runs it on Tagalong's own Node; see docs/brain.md) ---

# 1 to run the bridge. It starts only when this is 1 and the five values below are all set.
TAGALONG_WHATSAPP_ENABLED=

# Meta Cloud API access token. A secret: masked in logs, never given to the desktop or the model.
TAGALONG_WHATSAPP_ACCESS_TOKEN=

# Meta app secret, used to check each webhook's signature. A secret.
TAGALONG_WHATSAPP_APP_SECRET=

# The token Meta sends back when you register the webhook URL. A secret.
TAGALONG_WHATSAPP_VERIFY_TOKEN=

# The WhatsApp phone number id messages are sent from (not the phone number itself).
TAGALONG_WHATSAPP_PHONE_NUMBER_ID=

# The one number Scout answers, digits only with country code. Messages from any other number
# are ignored.
TAGALONG_WHATSAPP_ALLOWED_NUMBER=

# Local port the bridge listens on for Meta's webhook. Default: 47322
TAGALONG_WHATSAPP_PORT=

# --- desktop (pnpm dev:desktop, the packaged app, the e2e suites) ---

# Host:port the desktop dials for the brain. Default: 127.0.0.1:47321
# TAGALONG_BRAIN_ADDR (listed above) is the same variable, read by both sides.

# Set to 0 to stop `pnpm dev:desktop` starting a local brain when none is running.
# Set by the Electron e2e specs that need the brain to stay down.
TAGALONG_START_BRAIN=

# Set to 1 to point Chromium at its fake microphone (a built-in tone) instead of a real one,
# so the desktop streams audio with no microphone. Set by the Electron e2e tests.
TAGALONG_FAKE_MIC=
