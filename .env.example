# Copy to .env.local and fill in. .env.local is git-ignored.

# Anthropic Console API key. Required from Phase 1 for the default BrainProvider.
# A Claude Max subscription cannot be used here; see docs/specs for the policy reference.
ANTHROPIC_API_KEY=

# ElevenLabs API key. Required from Phase 3 for the TtsProvider.
ELEVENLABS_API_KEY=

# OpenAI API key. Used only for the Whisper speech-to-text endpoint. Required from Phase 3.
OPENAI_API_KEY=

# Set to 1 to force fake AI and voice providers. Used by tests and offline demos.
TAGALONG_FAKE_PROVIDERS=1
