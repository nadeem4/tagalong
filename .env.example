# Reference list of the environment variables this project uses. Nothing loads a .env
# file yet: there is no dotenv dependency, so copying this to .env.local has no effect.
# TAGALONG_FAKE_PROVIDERS and TAGALONG_SKIP_ONBOARDING are read straight from the shell;
# every API key is entered in Settings and stored through Electron safeStorage, never from here.

# OpenRouter API key, for pets on the 'openrouter' provider (https://openrouter.ai/api/v1).
# NOT read from here: enter it in Settings. Listed for reference only.
OPENROUTER_API_KEY=

# Nebius Token Factory API key, for pets on the 'nebius' provider
# (https://api.tokenfactory.nebius.com/v1/, Nemotron models). NOT read from here: enter it
# in Settings. Listed for reference only.
NEBIUS_API_KEY=

# Anthropic Console API key. NOT read from here: enter it in the app's Settings window,
# which stores it via safeStorage. Listed for reference only.
# A Claude Max subscription cannot be used here; see docs/specs for the policy reference.
ANTHROPIC_API_KEY=

# ElevenLabs API key. Not used yet; the TtsProvider arrives in Phase 3.
ELEVENLABS_API_KEY=

# OpenAI API key. Not used yet; Whisper speech to text arrives in Phase 3.
OPENAI_API_KEY=

# Read from the shell environment. Set it there, not in a file:
#   PowerShell   $env:TAGALONG_FAKE_PROVIDERS = '1'
#   bash         export TAGALONG_FAKE_PROVIDERS=1
# Forces the fake brain provider, so no key and no network are needed.
TAGALONG_FAKE_PROVIDERS=1

# Keeps the first-run setup wizard shut. Set by the Electron smoke tests, which count the
# windows a launch opens; a person never needs it (Skip setup in the wizard does the same).
TAGALONG_SKIP_ONBOARDING=
